# Copie este arquivo para ".env" e ajuste os valores.
# Depois de mexer no .env, pare o servidor (Ctrl+C) e rode "npm run dev" de novo.

# true  = usa dados de mentira dentro do próprio front (não precisa de Supabase)
# false = chama a Edge Function de verdade
VITE_USE_MOCK=true

# Supabase: Project Settings > API (URL do projeto e chave PÚBLICA).
# Nunca coloque aqui a chave secreta / service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Nome da Edge Function (combinado no contrato)
VITE_FUNCTION_NAME=recomendar-livros

# true = abre sempre em modo totem (também dá para usar http://localhost:5173/?totem)
VITE_MODO_TOTEM=false
